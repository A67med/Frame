{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frame",
  "version": "0.5.0",
  "identifier": "io.github.abdallahkattriah-sketch.frame",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Frame",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": [0, 0, 0, 255],
        "shadow": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "center": true,
        "browserExtensionsEnabled": true,
        "additionalBrowserArgs": "--disk-cache-size=104857600 --media-cache-size=52428800 --autoplay-policy=no-user-gesture-required --disable-features=HardwareMediaKeyHandling"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' https://www.youtube.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; img-src 'self' asset: https://asset.localhost data: blob: https: http:; media-src 'self' asset: https://asset.localhost blob: https: http:; connect-src 'self' ipc: http://ipc.localhost https: http: ws: wss:; font-src 'self' data: https://fonts.gstatic.com https://cdn.fontshare.com; object-src 'none'; frame-src 'self' https: http: stremio:; worker-src 'self' blob:; base-uri 'self'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Video",
    "publisher": "Frame",
    "copyright": "Copyright (c) 2026 Frame contributors. Based on Harbor, MIT License.",
    "shortDescription": "A personal desktop media app for movies and TV",
    "fileAssociations": [
      {
        "ext": ["mkv", "mp4", "avi", "mov", "webm", "m4v"],
        "name": "FrameVideo",
        "description": "Video file",
        "role": "Viewer"
      }
    ],
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg", "binaries/ffprobe"],
    "resources": {
      "fonts/*": "fonts/",
      "THIRD-PARTY-NOTICES.txt": "notices/",
      "resources/harbor-stream-blocker/": "resources/harbor-stream-blocker/",
      "resources/capstan/": "resources/capstan/"
    },
    "licenseFile": "installer/eula.txt",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["frame", "stremio"]
      }
    },
    "updater": {
      "endpoints": ["https://github.com/A67med/frame/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2NUEzQkUyMDE1OTdGOUMKUldTY2Yxa0I0anRhWnJNd2p5QXluVzRudUtWRWlmcEpoaDQxSVVrRGxNV01PbytRRFI2K0pKK0EK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
